<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application>
        <!-- Recibe mensajes del otro dispositivo (Wearable Data Layer) aunque la app esté cerrada. -->
        <service
            android:name="com.microbudget.data.sync.MicroBudgetListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/microbudget"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data
                    android:host="*"
                    android:path="/microbudget_sync"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!--
            Alternativa de prueba para emuladores SIN emparejar: el script tools/simular-sync.ps1
            intercambia paquetes por ADB. Protegido con DUMP: solo el shell de ADB (o el sistema)
            puede enviar este broadcast; las apps normales no.
        -->
        <receiver
            android:name="com.microbudget.data.sync.AdbSyncReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.microbudget.sync.EXPORT" />
                <action android:name="com.microbudget.sync.IMPORT" />
                <action android:name="com.microbudget.sync.ACK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
